<div class="slide-inner">
  {{> header}}

  <div class="contacts">
    {{#if cta}}<div class="contacts__cta">{{cta}}</div>{{/if}}
    <div>
      <div class="contacts__person">{{personName}}</div>
      {{#if role}}<div class="contacts__role">{{role}}</div>{{/if}}
      <div class="contacts__channels">
        {{#if phone}}
        <div class="channel">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5c0 8.284 6.716 15 15 15l3-4-6-3-2 2c-2.5-1.2-4.3-3-5.5-5.5l2-2-3-6-4 3.5Z"/></svg>
          {{phone}}
        </div>
        {{/if}}
        {{#if email}}
        <div class="channel">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z"/><path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6"/></svg>
          {{email}}
        </div>
        {{/if}}
        {{#if messenger}}
        <div class="channel">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a8 8 0 1 1-3.6-6.7L21 4l-1.3 3.6A7.96 7.96 0 0 1 21 12Z"/></svg>
          {{messenger}}
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{> footer}}
</div>
