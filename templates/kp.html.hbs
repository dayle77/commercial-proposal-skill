<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>{{meta.projectTitle}}</title>
<style>{{{fontFaceCss}}}</style>
<style>{{{brandVarsCss}}}</style>
<style>{{{stylesCss}}}</style>
</head>
<body>
{{#each deck}}
<section class="slide" data-slide="{{index}}">
  {{#if (eq type "cover")}}{{> cover data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "problem")}}{{> text-points data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "solution")}}{{> text-points data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "scope")}}{{> scope data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "timeline")}}{{> timeline data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "pricing")}}{{> pricing data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "cases")}}{{> cases data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "terms")}}{{> terms data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
  {{#if (eq type "contacts")}}{{> contacts data index=index totalSlides=@root.totalSlides meta=@root.meta brand=@root.brand}}{{/if}}
</section>
{{/each}}
</body>
</html>
